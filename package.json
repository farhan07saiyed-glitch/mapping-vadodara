{
  "name": "mapping-vadodara",
  "private": true,
  "version": "1.0.0",
  "description": "Mapping Vadodara — a frontend-only hyperlocal alternative-media prototype (React + Vite + Leaflet).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "db:check": "node server/check-db.js",
    "db:seed": "node server/seed.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "vite": "^5.4.11"
  }
}
